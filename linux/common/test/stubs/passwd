#!/bin/sh
# Test stub for passwd: "passwd -S NAME" reports the status code found for
# NAME in $FAKE_PASSWD_STATUS_FILE (lines of "name:code"), defaulting to P.
# "passwd -l NAME" records the call to $FAKE_ACTIONS_LOG instead of really
# locking anything.
if [ "$1" = "-l" ]; then
    [ -n "${FAKE_ACTIONS_LOG:-}" ] && echo "passwd -l $2" >> "$FAKE_ACTIONS_LOG"
    exit 0
fi
if [ "$1" = "-S" ]; then
    name="$2"
    if [ -n "${FAKE_PASSWD_STATUS_FILE:-}" ] && [ -r "$FAKE_PASSWD_STATUS_FILE" ]; then
        awk -F: -v n="$name" '$1==n{print n" "$2; found=1} END{if(!found) print n" P"}' "$FAKE_PASSWD_STATUS_FILE"
        exit 0
    fi
    echo "$name P"
    exit 0
fi
exit 1
