<ReportItem port="0" svc_name="general" protocol="tcp" severity="2" pluginID="205023" pluginName="Curl 7.32.0 &lt; 8.9.1 DoS (CVE-2024-7264)" pluginFamily="Misc.">
<age_of_vuln>60 - 180 days</age_of_vuln>
<agent>all</agent>
<asset_categories>component</asset_categories>
