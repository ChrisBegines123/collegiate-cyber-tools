<ReportItem port="0" svc_name="general" protocol="tcp" severity="2" pluginID="210055" pluginName="NumPy &lt; 1.22.0 Vulnerability - CVE-2021-34141" pluginFamily="Artificial Intelligence">
<age_of_vuln>730 days +</age_of_vuln>
<agent>all</agent>
<cpe>cpe:/a:numpy:numpy</cpe>
<cve>CVE-2021-34141</cve>
<cvss3_base_score>5.3</cvss3_base_score>
<cvss3_temporal_score>4.8</cvss3_temporal_score>
<cvss3_temporal_vector>CVSS:3.0/E:P/RL:O/RC:C</cvss3_temporal_vector>
<cvss3_vector>CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L</cvss3_vector>
<cvssV3_impactScore>1.4</cvssV3_impactScore>
