<ReportItem port="0" svc_name="general" protocol="tcp" severity="3" pluginID="192704" pluginName="Curl 7.44.0 &lt; 8.7.0 HTTP/2 Push Headers Memory-leak (CVE-2024-2398)" pluginFamily="Misc.">
